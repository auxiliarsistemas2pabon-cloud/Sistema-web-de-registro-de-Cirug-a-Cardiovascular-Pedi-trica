{
  "name": "cirugia-cardiovascular-pediatrica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:api": "node --test server/pruebas/api.test.mjs",
    "test:security": "node --test server/pruebas/seguridad.test.mjs server/pruebas/seguridad-produccion.test.mjs",
    "test:security:browser": "node scripts/probar-mysql.mjs browser",
    "test:security:mysql": "node scripts/probar-mysql.mjs",
    "test:security:tls": "node scripts/probar-mysql.mjs tls",
    "test:security:load": "node scripts/probar-mysql.mjs load",
    "security:scan": "node scripts/security/scan.mjs source",
    "security:secrets": "node scripts/security/scan.mjs secrets",
    "security:dependencies": "node scripts/security/dependencies.mjs",
    "security:images": "node scripts/security/scan.mjs image",
    "security:gate": "node scripts/security/gate.mjs",
    "security:test": "node --test scripts/security/controles.test.mjs",
    "security:test:patches": "node --test scripts/security/dependencias-corregidas.test.mjs",
    "security:install-hook": "node scripts/security/install-hook.mjs",
    "db:migrate": "node server/migrar.mjs",
    "backup": "node scripts/respaldo.mjs",
    "backup:verify": "node scripts/respaldo.mjs verificar",
    "deploy:prepare": "node deploy/prepare.mjs",
    "deploy:check": "node deploy/ops.mjs check",
    "deploy:up": "node deploy/ops.mjs up",
    "deploy:status": "node deploy/ops.mjs status",
    "deploy:backup": "node deploy/ops.mjs backup",
    "deploy:verify-backup": "node deploy/ops.mjs verify-backup",
    "deploy:test": "node --test deploy/config.test.mjs",
    "deploy:smoke": "node deploy/smoke.mjs",
    "seed:demo": "node server/seed-demo.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "picomatch": "$picomatch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "concurrently": "^9.2.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.14.4",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "picomatch": "file:vendor/picomatch"
  }
}
