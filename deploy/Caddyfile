{
  http_port 8080
  https_port 8443
  auto_https disable_redirects
  admin off
  persist_config off
  skip_install_trust
  log {
    format filter {
      wrap json
      fields {
        request delete
      }
    }
  }
  servers {
    timeouts {
      read_header 15s
      read_body 120s
      idle 60s
    }
    max_header_size 16KB
  }
}

http://{$APP_DOMAIN}:8080 {
  @fuera not remote_ip {$CLINIC_CIDRS}
  respond @fuera "Acceso restringido a la clínica." 403
  redir {$APP_ORIGIN}{uri} 308
}

https://{$APP_DOMAIN}:8443 {
  tls internal
  @fuera not remote_ip {$CLINIC_CIDRS}
  respond @fuera "Acceso restringido a la clínica." 403
  request_body {
    max_size 16MB
  }
  header -Server
  reverse_proxy app:3001 {
    transport http {
      dial_timeout 5s
      response_header_timeout 120s
    }
  }
}
