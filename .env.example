# Copie este archivo como .env y cambie TODOS los valores antes de desplegar.
PORT=3001

# MySQL 8.x (utf8mb4). Con docker-compose.yml el puerto local es 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cardio
DB_PASSWORD=cambie-esta-clave
DB_NAME=cardio_pediatrica

# Cadena aleatoria larga (>= 32 caracteres). Ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo se usan para crear el primer administrador si aún no existe ningún usuario.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
