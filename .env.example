# Copie este archivo como .env y cambie TODOS los valores antes de desplegar.
PORT=3443
HOST=127.0.0.1
NODE_ENV=development
LOCAL_HTTPS=true
LOCAL_TLS_PFX_FILE=.local-secrets/localhost.pfx
LOCAL_TLS_PFX_PASSWORD_FILE=.local-secrets/localhost-pfx.pass
# El configurador genera esta clave; no la pierda ni la cambie sin migrar las semillas MFA.
MFA_ENCRYPTION_KEY=
# Solo instalación inicial. El configurador cambia a false y separa las credenciales.
RUN_MIGRATIONS=true
# 0: acceso directo local. 1: exactamente un proxy inverso, sin acceso directo desde Internet.
TRUST_PROXY=0
SESSION_MINUTES=15
SESSION_MAX_HOURS=12

# MySQL 8.x (utf8mb4). Con docker-compose.yml el puerto local es 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cardio
DB_PASSWORD=cambie-esta-clave
DB_NAME=cardio_pediatrica

# Solo para Docker de desarrollo; elija una contraseña diferente de DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

# Solo se usan para crear el primer administrador si aún no existe ningún usuario.
# El configurador separa estos valores en .env.maintenance.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
